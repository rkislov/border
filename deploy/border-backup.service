[Unit]
Description=Border encrypted backup and recovery verification
After=border.service
Requires=border.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/bin/radiusd backup tick --config /etc/border-backup.json
TimeoutStartSec=35min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/border /var/backups/border /var/cache/border-downloads
RestrictAddressFamilies=AF_UNIX

