# Values are examples only. radiusd reads process environment; it does not load this file.
# Keep credentials out of source control. Use your service manager's secret environment.
BORDER_DB_DRIVER=sqlite
BORDER_DB=border.db

# Required for user portal, managed PKI, TOTP and ACME.
# Generate once using: radiusd gen-key. Preserve it across restarts and backups.
BORDER_MASTER_KEY=
BORDER_PORTAL_URL=https://portal.example.net
BORDER_PORTAL_VLAN=0

# AD: sAMAccountName or userPrincipalName. FreeIPA: uid.
# Empty URL disables domain login. ldap:// always upgrades using StartTLS.
BORDER_LDAP_URL=
BORDER_LDAP_BASE_DN=dc=example,dc=net
BORDER_LDAP_BIND_DN=cn=border-reader,ou=services,dc=example,dc=net
BORDER_LDAP_BIND_PASSWORD=
BORDER_LDAP_USER_ATTRIBUTE=sAMAccountName
BORDER_LDAP_CA=

# Empty SMTP address disables delivery. STARTTLS is required by default.
# For port 465 set BORDER_SMTP_TLS=implicit.
BORDER_SMTP_ADDRESS=
BORDER_SMTP_FROM=border@example.net
BORDER_SMTP_USERNAME=
BORDER_SMTP_PASSWORD=
BORDER_SMTP_TLS=starttls
BORDER_SMTP_CA=
